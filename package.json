{
  "name": "verglos-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "licenses:inventory": "node scripts/license-inventory.mjs --check",
    "licenses:notices": "node scripts/generate-third-party-notices.mjs --write",
    "sbom:cyclonedx": "node scripts/generate-sbom.mjs --write",
    "sbom:spdx": "node scripts/generate-spdx.mjs --write",
    "pack:public": "node scripts/pack-public-packages.mjs .artifacts/public-packages"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.17",
      "fast-uri": "3.1.7",
      "hono": "4.13.7",
      "ip-address": "10.7.0",
      "qs": "6.16.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
