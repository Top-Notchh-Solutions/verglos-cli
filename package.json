{
  "name": "verglos-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "licenses:inventory": "node scripts/license-inventory.mjs --check",
    "licenses:notices": "node scripts/generate-third-party-notices.mjs --write",
    "sbom:cyclonedx": "node scripts/generate-sbom.mjs --write",
    "sbom:spdx": "node scripts/generate-spdx.mjs --write",
    "pack:public": "node scripts/pack-public-packages.mjs .artifacts/public-packages",
    "acceptance:corpus:verify": "node scripts/verify-acceptance-corpus.mjs",
    "acceptance:corpus:triage": "node scripts/triage-public-oss-corpus.mjs",
    "acceptance:stories:verify": "node scripts/verify-acceptance-stories.mjs",
    "acceptance:protocol:check": "node scripts/validate-acceptance-protocol.mjs",
    "acceptance:comprehension:score": "node scripts/score-comprehension-test.mjs",
    "acceptance:commercial:validate": "node scripts/validate-commercial-acceptance.mjs",
    "acceptance:workflow:validate": "node scripts/validate-authorized-workflow.mjs",
    "acceptance:evidence:bundle": "node scripts/build-acceptance-evidence-bundle.mjs",
    "acceptance:study-protocols:check": "node scripts/validate-acceptance-study-protocols.mjs",
    "acceptance:release:reconcile": "node scripts/reconcile-release-gates.mjs",
    "acceptance:release:freeze": "node scripts/freeze-release-candidate.mjs",
    "acceptance:release:regress": "node scripts/run-final-regression.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.17",
      "fast-uri": "3.1.7",
      "hono": "4.13.7",
      "ip-address": "10.7.0",
      "qs": "6.16.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
