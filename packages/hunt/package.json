{
  "name": "@verglos/hunt",
  "version": "2.0.0-alpha.4",
  "description": "Bounded, approval-bound Hunt execution handoff and evidence helpers for Verglos.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @verglos/shared build && pnpm build && node ../../scripts/run-package-tests.mjs dist"
  },
  "dependencies": {
    "@verglos/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Top-Notchh-Solutions/verglos-cli.git",
    "directory": "packages/hunt"
  },
  "homepage": "https://verglos.com",
  "bugs": {
    "url": "https://github.com/Top-Notchh-Solutions/verglos-cli/issues"
  },
  "author": "Top Notchh Team",
  "keywords": [
    "security",
    "hunt",
    "sandbox",
    "evidence",
    "approval",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
